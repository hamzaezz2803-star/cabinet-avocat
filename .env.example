# Copier en .env.local (développement) et définir chez l'hébergeur (production).
# Ne jamais commiter de valeur réelle.

# URL publique du site (utilisée pour le SEO, le sitemap et les métadonnées)
NEXT_PUBLIC_SITE_URL=

# Envoi des demandes de contact (serveur uniquement, jamais NEXT_PUBLIC_)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
